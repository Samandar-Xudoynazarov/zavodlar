# PostgreSQL ulanish qatori: postgres://FOYDALANUVCHI:PAROL@HOST:5432/BAZA_NOMI
# Kompyuterda (lokal): postgres://postgres:PAROLINGIZ@localhost:5432/zavodlar
DATABASE_URL=postgres://postgres:parol@localhost:5432/zavodlar

# Birinchi kirish paroli: foydalanuvchi bo'lmaganda "admin" login va shu parol bilan kiriladi,
# bosh administrator va "1-zavod" avtomatik yaratiladi.
APP_PASSWORD=123456

# Kirish tokenlarini imzolash kaliti — kamida 16 belgi. O'zgartirilsa, hamma qaytadan kiradi.
# Yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Frontend manzili (vergul bilan bir nechta). Lokal: http://localhost:3000
CORS_ORIGIN=*

# Serverda (Apache/cPanel proksisi ortida) 1 qo'ying — mijoz IP'si to'g'ri aniqlanadi
TRUST_PROXY=

PORT=4000

# Telegram: token faqat backend muhitida; chatga / frontendga qo'ymang
TELEGRAM_BOT_TOKEN=
# BotFather'dagi bot username (@ belgisiz); bo'sh bo'lsa getMe orqali aniqlanadi
TELEGRAM_BOT_USERNAME=
# Webhook tekshirish kaliti, 16-256 ta A-Z/a-z/0-9/_/-; bot tokenidan boshqa kalit
TELEGRAM_WEBHOOK_SECRET=
# Ommaviy HTTPS backend manzili + /api/telegram/webhook
TELEGRAM_WEBHOOK_URL=
# Xabardagi kunlik hisobot havolasi uchun frontend manzili
APP_PUBLIC_URL=