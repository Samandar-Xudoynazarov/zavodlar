# PostgreSQL ulanish qatori: postgres://FOYDALANUVCHI:PAROL@HOST:5432/BAZA_NOMI
# Kompyuterda (lokal): postgres://postgres:PAROLINGIZ@localhost:5432/zavodlar
DATABASE_URL=postgres://postgres:parol@localhost:5432/zavodlar

# Birinchi kirish paroli: foydalanuvchi bo'lmaganda "admin" login va shu parol bilan kiriladi,
# bosh administrator va "1-zavod" avtomatik yaratiladi.
APP_PASSWORD=bu-yerga-birinchi-kirish-paroli

# Kirish tokenlarini imzolash kaliti — kamida 16 belgi. O'zgartirilsa, hamma qaytadan kiradi.
# Yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=bu-yerga-uzun-tasodifiy-satr-yozing

# Frontend manzili (vergul bilan bir nechta). Lokal: http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Serverda (Apache/cPanel proksisi ortida) 1 qo'ying — mijoz IP'si to'g'ri aniqlanadi
TRUST_PROXY=

PORT=4000

# Telegram: token faqat backend muhitida; chatga / frontendga qo'ymang
TELEGRAM_BOT_TOKEN=
# BotFather'dagi bot username (@ belgisiz); bo'sh bo'lsa getMe orqali aniqlanadi
TELEGRAM_BOT_USERNAME=zavodlarbot
# Webhook tekshirish kaliti, 16-256 ta A-Z/a-z/0-9/_/-; bot tokenidan boshqa kalit
TELEGRAM_WEBHOOK_SECRET=
# Ommaviy HTTPS backend manzili + /api/telegram/webhook
TELEGRAM_WEBHOOK_URL=https://api.zavodlar.uz/api/telegram/webhook
# Xabardagi kunlik hisobot havolasi uchun frontend manzili
APP_PUBLIC_URL=https://zavodlar.uz
# Ertalabki hisobot (kuzatuvchi — pulsiz, direktor — pul bilan). Soat Toshkent vaqti bilan; 0 — o'chirish
TELEGRAM_DIGEST=1
TELEGRAM_DIGEST_HOUR=8
# 1 — har kunlik reja saqlanganda ham kuzatuvchiga Telegram xabar (eski tartib). Standart: faqat ertalabki hisobot
TELEGRAM_PLAN_ALERTS=0

# Avtomatik kunlik zaxira (server.js ichida, doimiy serverda). 1 qo'yilsa har kuni bir marta
# scripts/backup.js ishga tushadi. Vercel'da ishlamaydi — u yerda tashqi cron ishlating.
AUTO_BACKUP=
# Zaxira soati (server vaqti bo'yicha, 0-23). Standart: 2 (tungi 2:00)
AUTO_BACKUP_HOUR=2
# Shifrlash kaliti, 64 ta hex belgi. Yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Kalitni yo'qotsangiz, zaxirani ochib bo'lmaydi — alohida joyda saqlang.
BACKUP_ENCRYPTION_KEY=
# Zaxira papkasi (web katalogidan tashqarida). Bo'sh bo'lsa: ~/zavodlar-private-backups
BACKUP_DIR=
# Nechta oxirgi zaxira saqlansin (1-60)
BACKUP_KEEP=30
